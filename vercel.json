{
  "rewrites": [
    {
      "source": "/playlist.m3u",
      "destination": "/api/channel/playlist"
    },
    {
      "source": "/tv.m3u",
      "destination": "/api/channel/playlist"
    },
    {
      "source": "/embed",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/nl",
      "destination": "/nl.html"
    },
    {
      "source": "/nederland",
      "destination": "/nl.html"
    },
    {
      "source": "/nordics",
      "destination": "/nl.html"
    },
    {
      "source": "/sponsors",
      "destination": "/nl.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
